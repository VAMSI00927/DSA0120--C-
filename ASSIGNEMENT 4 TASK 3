#include <iostream>
#include <string>
using namespace std;

class Address {
    string city;
    int pin;

public:
    Address(string c, int p) : city(c), pin(p) {
        cout << "Address constructed\n";
    }

    string getAddress() const {
        return city + "-" + to_string(pin);
    }

    ~Address() {
        cout << "Address destroyed\n";
    }
};

class Course {
    string courseName;

public:
    Course(string c) : courseName(c) {
        cout << "Course constructed\n";
    }

    string getCourse() const {
        return courseName;
    }

    ~Course() {
        cout << "Course destroyed\n";
    }
};

class Person {
protected:
    string name;
    int age;
    Address address;

public:
    Person(string n, int a, string city, int pin)
        : name(n), age(a), address(city, pin) {
        cout << "Person constructed\n";
    }

    virtual ~Person() {
        cout << "Person destroyed\n";
    }
};

class Student : virtual public Person {
protected:
    long long regNo;
    Course course;

public:
    Student(string n, int a, string city, int pin,
            long long r, string c)
        : Person(n, a, city, pin),
          regNo(r), course(c) {
        cout << "Student constructed\n";
    }

    ~Student() override {
        cout << "Student destroyed\n";
    }

    void display() const {
        cout << regNo << " " << name
             << " " << age << " "
             << address.getAddress() << " "
             << course.getCourse() << '\n';
    }
};

class Staff : virtual public Person {
protected:
    string department;
    double salary;

public:
    Staff(string n, int a, string city, int pin,
          string d, double s)
        : Person(n, a, city, pin),
          department(d), salary(s) {
        cout << "Staff constructed\n";
    }

    ~Staff() override {
        cout << "Staff destroyed\n";
    }
};

class TeachingAssistant : public Student, public Staff {
public:
    TeachingAssistant(string n, int a, string city, int pin,
                      long long r, string c,
                      string d, double s)
        : Person(n, a, city, pin),
          Student(n, a, city, pin, r, c),
          Staff(n, a, city, pin, d, s) {
        cout << "TeachingAssistant constructed\n";
    }

    ~TeachingAssistant() override {
        cout << "TeachingAssistant destroyed\n";
    }
};

int main() {
    Student s("Kavya", 19, "Salem", 636001,
              192311001, "C++");

    cout << "\nStudent Details:\n";
    s.display();

    cout << "\nTeaching Assistant:\n";

    TeachingAssistant ta(
        "Vamsi", 20, "Chennai", 600001,
        192525147, "C++", "IT", 25000
    );

    return 0;
}
