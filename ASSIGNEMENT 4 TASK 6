#include <iostream>
#include <vector>
#include <memory>
#include <string>
using namespace std;

class Vehicle {
protected:
    string vehicleNumber;
    string driverName;

public:
    Vehicle(string number, string driver)
        : vehicleNumber(number), driverName(driver) {}

    virtual void start() const = 0;
    virtual void display() const = 0;

    virtual ~Vehicle() = default;
};

class Bus : public Vehicle {
protected:
    int capacity;

public:
    Bus(string number, string driver, int seats)
        : Vehicle(number, driver), capacity(seats) {}

    void start() const override {
        cout << "Diesel bus started\n";
    }

    void display() const override {
        cout << "Bus Number: " << vehicleNumber << '\n';
        cout << "Driver: " << driverName << '\n';
        cout << "Capacity: " << capacity << '\n';
    }
};

class ElectricBus : public Bus {
    double batteryCapacity;
    double charge;

public:
    ElectricBus(string number, string driver,
                int seats, double battery, double currentCharge)
        : Bus(number, driver, seats),
          batteryCapacity(battery), charge(currentCharge) {}

    void start() const override {
        cout << "Electric bus started silently\n";
    }

    void display() const override {
        cout << "Electric Bus Number: "
             << vehicleNumber << '\n';
        cout << "Driver: " << driverName << '\n';
        cout << "Capacity: " << capacity << '\n';
        cout << "Battery Capacity: "
             << batteryCapacity << " kWh\n";
        cout << "Current Charge: "
             << charge << "%\n";
    }

    void chargeBattery(double amount) {
        charge += amount;

        if (charge > 100)
            charge = 100;
    }
};

int main() {
    vector<unique_ptr<Vehicle>> fleet;

    fleet.push_back(
        make_unique<Bus>("TN01AB1234", "Ravi", 50)
    );

    fleet.push_back(
        make_unique<ElectricBus>(
            "TN02CD5678", "Kumar", 40, 250, 80
        )
    );

    for (const auto& vehicle : fleet) {
        vehicle->display();
        vehicle->start();
        cout << "------------------\n";
    }

    return 0;
}
