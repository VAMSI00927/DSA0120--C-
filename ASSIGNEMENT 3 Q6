#include <cstring>
#include <iostream>

class Text {
    char* data;
public:
    explicit Text(const char* value = "") {
        if (!value) value = "";
        data = new char[std::strlen(value) + 1];
        std::strcpy(data, value);
    }
    Text(const Text& other) : data(new char[std::strlen(other.data) + 1]) {
        std::strcpy(data, other.data);
        std::cout << "Copy made\n";
    }
    Text& operator=(const Text& other) {
        if (this != &other) {
            char* fresh = new char[std::strlen(other.data) + 1];
            std::strcpy(fresh, other.data);
            delete[] data;
            data = fresh;
        }
        return *this;
    }
    Text operator+(const Text& other) const {
        std::size_t n1 = std::strlen(data), n2 = std::strlen(other.data);
        char* joined = new char[n1 + n2 + 1];
        std::strcpy(joined, data); std::strcat(joined, other.data);
        Text result(joined);
        delete[] joined;
        return result;
    }
    bool operator==(const Text& other) const { return std::strcmp(data, other.data) == 0; }
    bool operator!=(const Text& other) const { return !(*this == other); }
    friend std::ostream& operator<<(std::ostream& out, const Text& text) { return out << text.data; }
    ~Text() { delete[] data; }
};

int main() {
    Text first("Hello "), second("C++"), third(" World");
    Text message = first + second + third;
    std::cout << "Combined message: " << message << '\n';
    Text copy = message;
    std::cout << "Copy: " << copy << '\n';
    Text empty;
    empty = empty; // self-assignment
    std::cout << "Empty text: [" << empty << "]\n";
    std::cout << std::boolalpha << "Copy equals original: " << (copy == message) << '\n';
    std::cout << "Different texts: " << (first != second) << '\n';
}
