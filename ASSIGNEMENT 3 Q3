#include <iostream>
#include <stdexcept>
#include <string>

class Auditorium {
    int rows, seatsPerRow;
    char** seats;
    std::string eventName;
public:
    Auditorium(const std::string& name, int r, int s)
        : rows(r > 0 ? r : 0), seatsPerRow(s > 0 ? s : 0), seats(nullptr), eventName(name) {
        if (r < 0 || s < 0) throw std::invalid_argument("Rows and seats cannot be negative");
        if (rows > 0) {
            seats = new char*[rows]{};
            try {
                for (int i = 0; i < rows; ++i) {
                    seats[i] = new char[seatsPerRow];
                    for (int j = 0; j < seatsPerRow; ++j) seats[i][j] = 'O';
                }
            } catch (...) {
                for (int i = 0; i < rows; ++i) delete[] seats[i];
                delete[] seats;
                throw;
            }
        }
        std::cout << "Created: " << eventName << " (" << rows << 'x' << seatsPerRow << ")\n";
    }
    Auditorium(const Auditorium&) = delete;
    Auditorium& operator=(const Auditorium&) = delete;
    bool book(int r, int s) {
        if (r < 0 || r >= rows || s < 0 || s >= seatsPerRow || seats[r][s] == 'X') return false;
        seats[r][s] = 'X'; return true;
    }
    bool cancel(int r, int s) {
        if (r < 0 || r >= rows || s < 0 || s >= seatsPerRow || seats[r][s] == 'O') return false;
        seats[r][s] = 'O'; return true;
    }
    void display() const {
        for (int i = 0; i < rows; ++i) {
            for (int j = 0; j < seatsPerRow; ++j) std::cout << seats[i][j] << ' ';
            std::cout << '\n';
        }
    }
    ~Auditorium() {
        int booked = 0;
        for (int i = 0; i < rows; ++i) {
            for (int j = 0; j < seatsPerRow; ++j) if (seats[i][j] == 'X') ++booked;
            delete[] seats[i];
        }
        delete[] seats;
        std::cout << "Closed: " << eventName << " | Booked seats: " << booked << '\n';
    }
};

int main() {
    std::cout << "-- Stack object --\n";
    Auditorium morning("Morning Show", 2, 3);
    morning.book(0, 1); morning.book(1, 2); morning.cancel(0, 1); morning.display();
    std::cout << "-- Heap object --\n";
    Auditorium* evening = new Auditorium("Evening Show", 1, 2);
    evening->book(0, 0); evening->display(); delete evening;
    std::cout << "-- Block object --\n";
    { Auditorium special("Special Show", 1, 1); special.book(0, 0); }
    std::cout << "-- Zero-row object --\n";
    Auditorium empty("Empty Event", 0, 5);
}
