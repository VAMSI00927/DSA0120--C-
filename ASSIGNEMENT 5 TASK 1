#include <iostream>
#include <vector>
#include <memory>
#include <string>
using namespace std;

class Bill {
protected:
    string patient;

public:
    Bill(string p) : patient(p) {}

    virtual ~Bill() = default;

    virtual double total() const = 0;
    virtual string type() const = 0;

    void print() const {
        cout << type() << " "
             << patient << ": "
             << total() << '\n';
    }
};

class OutPatient : public Bill {
    double consultation, tests;

public:
    OutPatient(string p, double c, double t)
        : Bill(p), consultation(c), tests(t) {}

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OP";
    }
};

class InPatient : public Bill {
    int days;
    double perDay, surgery;

public:
    InPatient(string p, int d, double rate, double s)
        : Bill(p), days(d), perDay(rate), surgery(s) {}

    double total() const override {
        return days * perDay + surgery;
    }

    string type() const override {
        return "IP";
    }
};

class DayCareBill : public Bill {
    double package;

public:
    DayCareBill(string p, double amount)
        : Bill(p), package(amount) {}

    double total() const override {
        return package;
    }

    string type() const override {
        return "DAYCARE";
    }
};

class EmergencyBill : public Bill {
    double base, hourly;
    int hours;

public:
    EmergencyBill(string p, double b, double h, int hrs)
        : Bill(p), base(b), hourly(h), hours(hrs) {}

    double total() const override {
        return base + hourly * hours;
    }

    string type() const override {
        return "EMERGENCY";
    }
};

int main() {
    vector<unique_ptr<Bill>> bills;

    bills.push_back(
        make_unique<OutPatient>("Ravi", 500, 1200));

    bills.push_back(
        make_unique<InPatient>("Meena", 3, 2500, 40000));

    bills.push_back(
        make_unique<DayCareBill>("Arun", 18000));

    bills.push_back(
        make_unique<EmergencyBill>("Sara", 3000, 750, 4));

    double sum = 0;

    for (const auto& b : bills) {
        b->print();
        sum += b->total();
    }

    cout << "Daily total: " << sum << '\n';

    return 0;
}
