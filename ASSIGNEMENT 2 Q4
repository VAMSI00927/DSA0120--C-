#include <iostream>
#include <string>
using namespace std;

class SavingsAccount
{
private:
    string accountNumber;
    double balance;
    double transactions[10];
    int count;
    int nextIndex;

    void addTransaction(double amount)
    {
        transactions[nextIndex] = amount;

        nextIndex = (nextIndex + 1) % 10;

        if (count < 10)
            ++count;
    }

public:
    SavingsAccount(const string& number, double openingBalance)
        : accountNumber(number),
          balance(openingBalance),
          count(0),
          nextIndex(0)
    {
    }

    void deposit(double amount)
    {
        if (amount <= 0)
        {
            cout << "Deposit amount must be positive.\n";
            return;
        }

        balance += amount;
        addTransaction(amount);
    }

    void withdraw(double amount)
    {
        if (amount <= 0 || amount > balance)
        {
            cout << "Invalid withdrawal.\n";
            return;
        }

        balance -= amount;
        addTransaction(-amount);
    }

    void miniStatement() const;

    double getBalance() const
    {
        return balance;
    }
};

void SavingsAccount::miniStatement() const
{
    cout << "\nAccount: " << accountNumber;
    cout << "\nBalance: Rs. " << balance;
    cout << "\nLast " << count << " transactions:\n";

    int start = (count == 10) ? nextIndex : 0;

    for (int i = 0; i < count; ++i)
    {
        int index = (start + i) % 10;

        if (transactions[index] >= 0)
            cout << "Deposit: Rs. "
                 << transactions[index] << '\n';
        else
            cout << "Withdraw: Rs. "
                 << -transactions[index] << '\n';
    }
}

int main()
{
    SavingsAccount account("SB1001", 5000);

    account.deposit(1000);
    account.withdraw(500);
    account.deposit(750);
    account.withdraw(200);
    account.deposit(300);
    account.withdraw(100);
    account.deposit(400);
    account.withdraw(250);
    account.deposit(600);
    account.withdraw(150);
    account.deposit(900);

    account.miniStatement();

    return 0;
}
