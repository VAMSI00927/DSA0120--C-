#include <iostream>
using namespace std;

struct Parcel
{
    double weightKg;
    bool express;
    bool insured;
};

double charge(double weightKg,
              bool express = false,
              bool insured = false)
{
    double amount = weightKg * 40.0;

    if (express)
        amount += 30.0;

    if (insured)
        amount += 20.0;

    return amount;
}

double charge(int weightGrams)
{
    return (weightGrams / 1000.0) * 40.0;
}

double charge(float weightKg)
{
    return static_cast<double>(weightKg) * 40.0;
}

double charge(const Parcel& p)
{
    return charge(p.weightKg, p.express, p.insured);
}

int main()
{
    cout << "charge(2) = Rs. " << charge(2) << '\n';

    cout << "charge(2.0) = Rs. "
         << charge(2.0) << '\n';

    cout << "charge(2.0f) = Rs. "
         << charge(2.0f) << '\n';

    cout << "charge(2000) = Rs. "
         << charge(2000) << '\n';

    cout << "charge(2,true) = Rs. "
         << charge(2.0, true) << '\n';

    Parcel p = {2.0, true, true};

    cout << "charge(Parcel) = Rs. "
         << charge(p) << '\n';

    return 0;
}
