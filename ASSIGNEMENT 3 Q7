#include <cmath>
#include <iostream>
#include <iomanip>
#include <stdexcept>

class Complex {
    double realPart, imagPart;
public:
    Complex() : realPart(0), imagPart(0) {}
    Complex(double real) : realPart(real), imagPart(0) {}
    Complex(double real, double imag) : realPart(real), imagPart(imag) {}
    double real() const { return realPart; }
    double imag() const { return imagPart; }
    double magnitude() const { return std::sqrt(realPart * realPart + imagPart * imagPart); }
    Complex operator+(const Complex& z) const { return {realPart + z.realPart, imagPart + z.imagPart}; }
    Complex operator-(const Complex& z) const { return {realPart - z.realPart, imagPart - z.imagPart}; }
    Complex operator*(const Complex& z) const {
        return {realPart * z.realPart - imagPart * z.imagPart,
                realPart * z.imagPart + imagPart * z.realPart};
    }
    Complex operator/(const Complex& z) const {
        double denominator = z.realPart * z.realPart + z.imagPart * z.imagPart;
        if (denominator < 1e-12) throw std::runtime_error("Division by zero impedance");
        return {(realPart * z.realPart + imagPart * z.imagPart) / denominator,
                (imagPart * z.realPart - realPart * z.imagPart) / denominator};
    }
    bool operator==(const Complex& z) const {
        return std::abs(realPart - z.realPart) < 1e-9 && std::abs(imagPart - z.imagPart) < 1e-9;
    }
    friend std::ostream& operator<<(std::ostream& out, const Complex& z) {
        out << std::fixed << std::setprecision(2) << z.realPart;
        if (z.imagPart >= 0) out << " + j" << z.imagPart;
        else out << " - j" << -z.imagPart;
        return out;
    }
};

int main() {
    const double pi = std::acos(-1.0), frequency = 50.0, omega = 2.0 * pi * frequency;
    const double R = 10.0, L = 0.1, C = 100e-6;
    Complex zR(R, 0.0);
    Complex zL(0.0, omega * L);
    Complex zC(0.0, -1.0 / (omega * C));
    Complex series = zR + zL + zC;
    Complex parallel = (zR * zL) / (zR + zL);
    std::cout << "Resistor impedance: " << zR << '\n';
    std::cout << "Inductor impedance: " << zL << '\n';
    std::cout << "Capacitor impedance: " << zC << '\n';
    std::cout << "Series RLC impedance: " << series << " ohm\n";
    std::cout << "Series magnitude: " << series.magnitude() << " ohm\n";
    std::cout << "Parallel R-L impedance: " << parallel << " ohm\n";
    std::cout << "Parallel magnitude: " << parallel.magnitude() << " ohm\n";
    try { Complex invalid = zR / Complex(0, 0); std::cout << invalid << '\n'; }
    catch (const std::runtime_error& e) { std::cout << "Safe error: " << e.what() << '\n'; }
}
