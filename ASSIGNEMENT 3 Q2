#include <iostream>
#include <string>
#include <utility>

class Prescription {
    int n;
    std::string* medicines;
public:
    explicit Prescription(int count) : n(count > 0 ? count : 0), medicines(n ? new std::string[n] : nullptr) {}
    Prescription(const Prescription& other)
        : n(other.n), medicines(n ? new std::string[n] : nullptr) {
        for (int i = 0; i < n; ++i) medicines[i] = other.medicines[i];
        std::cout << "Deep-copy constructor called\n";
    }
    Prescription& operator=(const Prescription& other) {
        if (this != &other) {
            std::string* fresh = other.n ? new std::string[other.n] : nullptr;
            for (int i = 0; i < other.n; ++i) fresh[i] = other.medicines[i];
            delete[] medicines;
            medicines = fresh;
            n = other.n;
        }
        return *this;
    }
    ~Prescription() { delete[] medicines; }
    void set(int i, const std::string& medicine) {
        if (i < 0 || i >= n) throw std::out_of_range("Medicine index out of range");
        medicines[i] = medicine;
    }
    std::string get(int i) const {
        if (i < 0 || i >= n) throw std::out_of_range("Medicine index out of range");
        return medicines[i];
    }
};

int main() {
    Prescription p(2);
    p.set(0, "Paracetamol"); p.set(1, "ORS");
    Prescription q = p;                 // copy constructor
    q.set(1, "Cetirizine");
    Prescription r(1);
    r = p;                              // copy assignment
    p.set(0, "Ibuprofen");
    std::cout << p.get(0) << ' ' << p.get(1) << " | "
              << q.get(0) << ' ' << q.get(1) << " | "
              << r.get(0) << ' ' << r.get(1) << '\n';
    r = r;                              // self-assignment test
    std::cout << "Self-assignment completed safely\n";
}
